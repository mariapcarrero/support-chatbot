# Which provider serves the model. "anthropic" (default) or "openrouter".
# Both speak the same Anthropic Messages API, so this is the only switch needed —
# base URL, auth scheme, and model-id prefix are handled in src/lib/ai/client.ts.
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Required when LLM_PROVIDER=openrouter. https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Without it the app still answers and remembers the conversation
# (in-process store), but nothing is stored durably. /api/health reports the state.
#
# Provisioned automatically by the Neon integration on Vercel. That integration
# offers a "custom variable prefix", so the code accepts any of these, first match wins:
#   DATABASE_URL, POSTGRES_URL, NEON_DATABASE_URL, NEON_POSTGRES_URL
# Production currently uses NEON_DATABASE_URL. /api/health reports `databaseSource`.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional. Used for OpenRouter attribution headers only.
APP_URL=http://localhost:3000
